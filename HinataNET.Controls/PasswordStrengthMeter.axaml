<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HinataNET.Controls.PasswordStrengthMeter"
             x:Name="Root">

    <UserControl.Styles>
        <Style Selector="TextBox.ModernTextBox">
            <Setter Property="Background" Value="#0AFFFFFF" />
            <Setter Property="BorderBrush" Value="#20FFFFFF" />
            <Setter Property="SelectionBrush" Value="#806366F1" />
            <Setter Property="SelectionForegroundBrush" Value="White" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.3" />
                    <BrushTransition Property="Background" Duration="0:0:0.3" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="TextBox.ModernTextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#15FFFFFF" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
        </Style>

        <Style Selector="TextBox.ModernTextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#0AFFFFFF" />
            <Setter Property="BorderBrush" Value="#6366F1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
        </Style>

        <Style Selector="ToggleButton.EyeButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>

        <Style Selector="ToggleButton.EyeButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ToggleButton.EyeButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style Selector="ToggleButton.EyeButton:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ToggleButton.EyeButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="10">
        <TextBox Name="PasswordBox"
                 Classes="ModernTextBox"
                 Text="{Binding Password, ElementName=Root}"
                 PlaceholderText="{Binding Placeholder, ElementName=Root}"
                 PasswordChar="•"
                 UseFloatingPlaceholder="False">
            <TextBox.InnerRightContent>
                <ToggleButton Name="RevealButton"
                              Classes="EyeButton"
                              Click="RevealButton_OnClick">
                    <PathIcon Name="EyeIcon"
                              Width="18"
                              Height="18"
                              Foreground="#80FFFFFF"
                              Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z" />
                </ToggleButton>
            </TextBox.InnerRightContent>
        </TextBox>

        <Border Height="4"
                Background="#15FFFFFF"
                CornerRadius="2"
                ClipToBounds="True">
            <Border Name="StrengthIndicator"
                    Height="4"
                    HorizontalAlignment="Stretch"
                    Background="#F43F5E"
                    CornerRadius="2"
                    RenderTransformOrigin="0%,50%"
                    RenderTransform="scaleX(0)">
                <Border.Transitions>
                    <Transitions>
                        <TransformOperationsTransition Property="RenderTransform"
                                                       Duration="0:0:0.35"
                                                       Easing="CubicEaseOut" />
                        <BrushTransition Property="Background"
                                         Duration="0:0:0.35"
                                         Easing="CubicEaseOut" />
                    </Transitions>
                </Border.Transitions>
            </Border>
        </Border>

        <TextBlock Name="StrengthText"
                   HorizontalAlignment="Right"
                   Foreground="#60FFFFFF"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Text="Password strength"
                   LetterSpacing="0.5" />
    </StackPanel>
</UserControl>