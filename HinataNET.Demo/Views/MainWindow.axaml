<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HinataNET.Demo.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1200"
        Height="800"
        Background="#0A0A0A"
        xmlns:vm="using:HinataNET.Demo.ViewModels"
        WindowStartupLocation="CenterScreen"
        Title="HinataNET - Open Source Premium UI Library">

    <Grid ColumnDefinitions="260, *">

        <Border Grid.Column="0"
                Background="#050505"
                BorderBrush="#1AFFFFFF"
                BorderThickness="0,0,1,0">
            <StackPanel>

                <TextBlock Margin="24,32,24,10"
                           FontSize="20"
                           FontWeight="Black"
                           Text="HINATA.NET"
                           LetterSpacing="2">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Offset="0" Color="White" />
                            <GradientStop Offset="1" Color="#80FFFFFF" />
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>

                <TextBlock Margin="24,24,0,12"
                           Foreground="#50FFFFFF"
                           FontSize="11"
                           FontWeight="Bold"
                           Text="COMPONENTS"
                           LetterSpacing="1" />

                <ListBox Margin="12,0"
                         Background="Transparent"
                         ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding CurrentPage}">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Foreground" Value="#A0FFFFFF" />
                            <Setter Property="Transitions">
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                                    <BrushTransition Property="Foreground" Duration="0:0:0.2" />
                                </Transitions>
                            </Setter>
                        </Style>

                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="#15FFFFFF" />
                        </Style>
                        <Style Selector="ListBoxItem:selected">
                            <Setter Property="Foreground" Value="White" />
                        </Style>

                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="#0AFFFFFF" />
                        </Style>
                        <Style Selector="ListBoxItem:pointerover">
                            <Setter Property="Foreground" Value="White" />
                        </Style>
                    </ListBox.Styles>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock x:DataType="vm:IPageViewModel"
                                       Foreground="{Binding $parent[ListBoxItem].Foreground}"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Text="{Binding Title}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <Panel Grid.Column="1" Background="Transparent">
            <TransitioningContentControl Content="{Binding CurrentPage}">
                <TransitioningContentControl.PageTransition>
                    <CrossFade Duration="0:0:0.3" />
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>
        </Panel>

    </Grid>
</Window>