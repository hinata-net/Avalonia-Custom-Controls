<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="HinataNET.Demo.Views.ExpandingSearchBarPageView"
             xmlns:vm="clr-namespace:HinataNET.Demo.ViewModels"
             xmlns:controls="using:HinataNET.Controls"
             d:DesignWidth="800"
             d:DesignHeight="450"
             mc:Ignorable="d">

    <Grid Background="#1C1C1E">
        <controls:ExpandingSearchBar HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     ClipToBounds="False" />
    </Grid>
</UserControl>