<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="HinataNET.Demo.Views.PasswordStrengthMeterPageView"
             x:DataType="vm:PasswordStrengthMeterPageViewModel"
             xmlns:controls="using:HinataNET.Controls"
             xmlns:vm="using:HinataNET.Demo.ViewModels"
             d:DesignWidth="400"
             d:DesignHeight="700"
             mc:Ignorable="d">

    <UserControl.Styles>
        <Style Selector="Button.ModernButton">
            <Setter Property="Background" Value="#6366F1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Height" Value="46" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.ModernButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.ModernButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#4F46E5" />
        </Style>

        <Style Selector="Button.ModernButton:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>

        <Style Selector="Button.ModernButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#4338CA" />
        </Style>

        <Style Selector="Button.ModernButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#10FFFFFF" />
        </Style>

        <Style Selector="Button.ModernButton:disabled">
            <Setter Property="Foreground" Value="#40FFFFFF" />
        </Style>
    </UserControl.Styles>

    <Grid Background="#0A0A0A">
        <Border Width="360"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#141414"
                CornerRadius="16"
                BoxShadow="0 10 30 0 #20000000">

            <StackPanel>
                <TextBlock Margin="0,0,0,12"
                           HorizontalAlignment="Center"
                           Foreground="#50FFFFFF"
                           FontSize="12"
                           FontWeight="Bold"
                           Text="SECURITY CHECK"
                           LetterSpacing="2" />

                <controls:PasswordStrengthMeter Password="{Binding UserPassword}"
                                                Placeholder="Enter password"
                                                MinLength="10"
                                                RequireDigit="True"
                                                RequireUppercase="True"
                                                RequireSpecialChar="True"
                                                Strength="{Binding CurrentStrength, Mode=OneWayToSource}" />

                <Button Classes="ModernButton"
                        Margin="0,20,0,0"
                        Content="SUBMIT"
                        Command="{Binding SubmitCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>