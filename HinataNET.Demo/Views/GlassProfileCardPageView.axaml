<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HinataNET.Demo.Views.GlassProfileCardPageView"
             x:DataType="vm:GlassProfileCardPageViewModel"
             xmlns:controls="using:HinataNET.Controls"
             xmlns:vm="using:HinataNET.Demo.ViewModels"
             ClipToBounds="False">

    <Panel ClipToBounds="True">

        <Panel.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="#1E1B4B" />
                <GradientStop Offset="0.5" Color="#0F172A" />
                <GradientStop Offset="1" Color="#020617" />
            </LinearGradientBrush>
        </Panel.Background>

        <Panel Opacity="0.08" IsHitTestVisible="False">
            <Panel.Background>
                <VisualBrush TileMode="Tile"
                             SourceRect="0,0,32,32"
                             DestinationRect="0,0,32,32">
                    <VisualBrush.Visual>
                        <Ellipse Width="2"
                                 Height="2"
                                 Margin="15"
                                 Fill="#FFFFFF" />
                    </VisualBrush.Visual>
                </VisualBrush>
            </Panel.Background>
        </Panel>

        <Border Padding="40" ClipToBounds="False" />

    </Panel>
</UserControl>