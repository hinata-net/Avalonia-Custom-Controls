    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HinataNET.Controls\HinataNET.Controls.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\GlassProfileCardPageView.axaml.cs">
      <DependentUpon>GlassProfileCardPageView.axaml</DependentUpon>
    </Compile>
  </ItemGroup>
