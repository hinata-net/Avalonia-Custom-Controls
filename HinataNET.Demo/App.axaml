<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HinataNET.Demo.App"
             xmlns:views="using:HinataNET.Demo.Views"
             xmlns:vm="using:HinataNET.Demo.ViewModels"
             RequestedThemeVariant="Default">
    <!--  "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options.  -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.DataTemplates>
        <DataTemplate DataType="{x:Type vm:GlassAuthPageViewModel}">
            <views:GlassAuthPageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExpandingSearchBarPageViewModel}">
            <views:ExpandingSearchBarPageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SlideToActionPageViewModel}">
            <views:SlideToActionPageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PasswordStrengthMeterPageViewModel}">
            <views:PasswordStrengthMeterPageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GlassProfileCardPageViewModel}">
            <views:GlassProfileCardPageView />
        </DataTemplate>
    </Application.DataTemplates>
</Application>